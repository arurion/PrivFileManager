<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 通常ファイルアクセス -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Shizuku (Sui含む) が内部的に利用する権限 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
      debuggableアプリの列挙に必要。Android 11+ (targetSdk 30+) では
      パッケージ可視性フィルタリングにより、この権限なしでは
      getInstalledApplications() が自アプリ関連パッケージしか返さない。
      本アプリはPlay Store配布を想定しないサイドロード用ツールのため許容する。
      (Play Store配布する場合はQUERY_ALL_PACKAGESではなく<queries>での
      個別宣言に置き換える必要がある)
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- ネットワーク (GitHub API / clone用) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- APKファイルを直接インストールできるようにする -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 圧縮/展開などの時間のかかる処理をフォアグラウンドサービス+通知で実行するため -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".PrivFmApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PrivFileManager"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.TextEditorActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BinaryViewerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.GitCloneActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AppDataBrowserActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- 圧縮/展開などの長時間処理をバックグラウンドでも継続させるためのフォアグラウンドサービス -->
        <service
            android:name=".service.ArchiveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Shizuku公式ガイド必須項目: ShizukuProviderの明示宣言 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 外部アプリへ「〇〇で開く」で渡すためのFileProvider。
             privileged経路(Shizuku/Root/run-as)で読んだファイルは、
             一旦このアプリのキャッシュ領域にコピーしてから安全に共有する。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
