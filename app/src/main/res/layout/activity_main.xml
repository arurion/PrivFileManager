<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_base">

    <!-- ヘッダー(chrome): ツールバー + ステータス + パンくずナビ を1枚のガラス質感パネルにまとめる。
         各行を個別の灰色ボックスに分割しない(anti-Bento)。境界線ではなく
         下端の淡いエッジハイライトのみで本体コンテンツと区切る。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/content_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:titleTextColor="@color/text_on_chrome"
            app:title="@string/app_name" />

        <TextView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:textColor="@color/text_on_chrome"
            android:alpha="0.85"
            android:text="モード: 通常権限" />

        <!-- パンくずナビ(タップで任意階層へ直接移動できる) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/breadcrumbContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingBottom="10dp" />
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/chrome_edge_highlight" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/loadingIndicator"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/fileListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/content_surface" />

        <!-- 新規作成の主要な導線。ファイル操作アプリで最も頻繁に使われる操作の一つなので、
             オーバーフローメニューの奥に埋めず、常に手の届く位置に固定表示する
             (要所を光・影ではっきり立たせる、という原則1の例外にあたる要素)。 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCreate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="@string/action_new_folder"
            app:srcCompat="@drawable/ic_add"
            app:tint="@android:color/white"
            app:backgroundTint="@color/chrome_tint" />

    </FrameLayout>

</LinearLayout>
